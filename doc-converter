#!/usr/bin/env bash
#
# doc-converter
#
# Converts Markdown to HTML and/or PDF.

set -euo pipefail

# --from gfm 	github-flavored markdown
# --standalone 	emit proper html and head tags
pandoc --from gfm --to html5 --standalone --css style.css --output markdown-test.html markdown-test.md 

# Piping through weasyprint to convert HTML to PDF bypasses need for LaTeX styles, when added
pandoc --from gfm --to html5 --standalone --css style.css markdown-test.md | weasyprint --base-url "$PWD/" - markdown-test.pdf

ls -l markdown-test.html markdown-test.pdf

