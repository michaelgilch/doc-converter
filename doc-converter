#!/usr/bin/env bash
#
# doc-converter
#
# Converts Markdown to HTML and/or PDF.

set -euo pipefail

prog=${0##*/}

usage() {
	cat <<EOF
Usage: $prog FILE.md FORMAT [-o OUTPUT]

Convert a markdown file to a Nord-styled HTML or PDF document.

Arguments:
	FILE.md 	Source markdown file.
	FORMAT 		html or pdf.

Options:
	-o, --output 	Write to this path instead of next to the source
					(default: FILE.html or FILE.pdf alongside FILE.md).
	-h, --help		Show this help.

EOF
}

error_exit() {
	printf '%s: %s\n\n' "$prog" "$*" >&2
	exit 1
}

output=""
positional=()

while (($# > 0)); do
	case $1 in 
	-o|--output)
		(($# >= 2)) || error_exit "$1 needs a path"
		output=$2
		shift 2
		;;
	-h|--help)
		usage
		exit 0
		;;
	-?*)
		error_exit "Unknown option: $1"
		;;
	*)
		positional+=("$1")
		shift
		;;
	esac
done

((${#positional[@]} == 2)) \
	|| error_exit "expected FILE and FORMAT, got ${#positional[@]} argument(s)"

input=${positional[0]}
format=${positional[1],,}

case $format in
	html|pdf) ;;
	*) error_exit "FORMAT must be html or pdf, got '$format'" ;;
esac

[[ -f $input ]] || error_exit "no such file: $input"

src_dir=$(dirname "$input")
base=$(basename "$input")
stem=${base%.*}

if [[ -z $output ]]; then
	output=$src_dir/$stem.$format
fi

pandoc_args=(
	--from gfm		# github-flavored markdown
	--to html5
	--standalone 	# emit proper html and head tags
	--css style.css
)

case $format in 
	html)
		pandoc "${pandoc_args[@]}" --output "$output" "$input"
		;;
	pdf)
		# Piping html through weasyprint to convert to PDF 
		# bypasses the need for LaTeX stylesheets.
		pandoc "${pandoc_args[@]}" "$input" \
			| weasyprint --base-url "$PWD/" - "$output"
		;;
esac

printf '%s\n' "$output"

